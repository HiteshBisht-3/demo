85:                      <%= f.submit "Post", class: "px-6 py-2 bg-black text-white font-medium rounded-lg hover:bg-purple-600 focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 transition-all duration-200 whitespace-nowrap" %>
86:                    </div>
87:                  <% end %>
88:                </div>
89:              </div>
90:            </div>
91:          </div>
92:        <% else %>
93:          <% random_user = User.pick_random %>
94:          <% if random_user %>
95:            <div class="bg-white shadow-xl rounded-xl overflow-hidden mb-10 transition-all duration-300 hover:shadow-2xl">
96:              <div class="border-b p-4 flex items-center space-x-4 bg-gradient-to-r from-purple-50 to-pink-50">
97:                <div class="relative w-12 h-12">
98:                  <% if random_user.image.attached? %>
99:                    <%= image_tag random_user.image, class: "w-12 h-12 rounded-full object-cover ring-2 ring-purple-200 ring-offset-2", alt: "#{random_user.username}'s profile" %>
100:                  <% else %>
101:                    <div class="w-12 h-12 rounded-full overflow-hidden ring-2 ring-purple-200 ring-offset-2 bg-gradient-to-br from-purple-400 to-pink-400 flex items-center justify-center">
102:                      <span class="text-white font-bold text-lg">
103:                        <%= random_user.email[0].upcase %>
104:                      </span>
105:                    </div>
106:                  <% end %>
107:                </div>
108:    
109:                <%= link_to profile_path(random_user), class: "font-medium text-gray-900 hover:text-purple-600 transition-colors duration-200" do %>
110:                  <span class="text-lg"><%= random_user.username %></span>
111:                <% end %>
112:              </div>
113:    
114:              <div class="space-y-8 p-4">
115:                <div class="bg-white rounded-lg overflow-hidden shadow-md">
116:                  <% if post.file.attached? %>
117:                    <% if post.file.image? %>
118:                      <%= image_tag post.file, class: "w-full h-full object-cover", alt: "Post by #{random_user.username}" %>
119:                    <% elsif post.file.video? %>
120:                      <%= video_tag(url_for(post.file), class: "w-full h-full object-cover", alt: "Post video") %>
121:                    <% end %>
122:                  <% end %>
123:                </div>
124:    
125:                <div class="p-6">
126:                  <h4 class="text-xl font-medium text-gray-900 mb-3"><strong>Caption: </strong><%= post.caption %></h4>
127:                  <p class="text-sm text-gray-500 mb-6 flex items-center">
128:                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
129:                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
130:                    </svg>
131:                    <%= post.created_at.strftime("%B %d, %Y") %>
132:                  </p>
133:    
134:                  <%= form_with url: post_likes_path(post), method: :post, local: true, class: "inline-block" do %>
135:                    <button type="submit" class="group flex items-center space-x-2 text-gray-500 hover:text-red-500 transition-colors duration-200">
136:                      <svg class="w-7 h-7 transform group-hover:scale-110 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
137:                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
138:                      </svg>
139:                      <span class="font-medium">
140:                        <%= post.like_count %> Like<%= 's' if post.like_count != 1 %>
141:                      </span>
142:                    </button>
143:                  <% end %>
144:    
145:                  <div class="mt-8">
146:                    <h5 class="text-lg font-semibold text-gray-900 mb-4">Comments</h5>
147:                    <% if post.comments.any? %>
