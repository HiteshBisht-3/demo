149:                        <% post.comments.each do |comment| %>
150:                          <li class="bg-gray-50 p-4 rounded-lg">
151:                            <p class="text-gray-800 mb-2"><%= comment.content %></p>
152:                            <div class="flex items-center justify-between">
153:                              <div class="flex items-center space-x-2 text-sm text-gray-500">
154:                                <span class="font-medium"><%= comment.user.username %></span>
155:                                <span>•</span>
156:                                <span><%= comment.created_at.strftime("%B %d, %Y") %></span>
157:                              </div>
158:                              <% if current_user == comment.user %>
159:                                <%= link_to 'Delete', [comment.post, comment], class: "text-sm text-gray-400 hover:text-red-500 transition-colors duration-200", method: :delete, data: { confirm: 'Are you sure?', turbo_method: :delete } %>
160:                              <% end %>
161:                            </div>
162:                          </li>
163:                        <% end %>
164:                      </ul>
165:                    <% else %>
166:                      <p class="text-gray-500 italic">No comments yet. Be the first to comment!</p>
167:                    <% end %>
